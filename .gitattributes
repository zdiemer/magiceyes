# magiceyes ships shell scripts + C that must run under Linux/WSL — keep LF
# regardless of the host's core.autocrlf so the build/launcher scripts work.
*.sh  text eol=lf
*.py  text eol=lf
*.c   text eol=lf
*.h   text eol=lf
*.S   text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.txt  text eol=lf
*.lock text eol=lf
# read line-by-line by build_release.sh / apply_and_build.sh: a CRLF checkout would put a
# stray  on every patch filename and the loop would fail to find any of them.
*.list text eol=lf
LICENSE        text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# SVG is checked in as source (the README banner) -- keep it LF too.
*.svg text eol=lf
