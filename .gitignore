bin/
dist/
rootfs/
tmp_dyn/
*.o
*.so*
__pycache__/
*.pyc
.pytest_cache/

# large/derivable GP2X+Wiz assets (rootfs, SDK, games, firmware, paeryn-sdl)
/assets/

# headless-harness output: captured frame PNGs (game imagery) + per-run reports/scorecards.
# The committed regression baselines (perceptual hashes, no imagery) live in tools/test/baselines/.
/tools/test/results/

# Claude Code session runtime state (scheduled-wakeup lock, etc.) -- not project config.
/.claude/scheduled_tasks.lock

# Generated corpus-sweep manifest (~1.6MB of per-title verdicts + log excerpts). Regenerate with
# tools/test/compat_report.py; the human-readable CORPUS_SWEEP.md is committed instead.
/tools/test/compat_manifest.json

# ad-hoc triage scripts a session writes while debugging (not part of the harness)
/tools/test/scratch/


# Local machine config: private hosts/paths that must never be committed.
tools/local.env

# MCP server config: holds an absolute path to this checkout, so it is per-developer.
# Copy .mcp.json.example to .mcp.json and edit the path.
.mcp.json
